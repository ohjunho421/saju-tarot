PORT=3001
NODE_ENV=development

# Database URL
# 로컬 개발: SQLite
DATABASE_URL=file:./dev.db
# Railway 배포: PostgreSQL (자동 설정됨)
# DATABASE_URL=postgresql://user:password@host:5432/saju_tarot

# JWT Secret
JWT_SECRET=your-secret-key-change-in-production

# AI APIs (하나 이상 설정 필요)
# Gemini API (추천)
GEMINI_API_KEY=your_gemini_api_key_here

# Claude/Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 클라이언트 URL
CLIENT_URL=http://localhost:5173

# 카카오 로그인 (비워 두면 카카오 버튼이 보이지 않음)
# 카카오 개발자 콘솔 > 앱 > 플랫폼 키의 REST API 키, 카카오 로그인 > 보안의 Client Secret
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 카카오 개발자 콘솔 > 카카오 로그인 > Redirect URI에 똑같이 등록
# 로컬: http://localhost:3001/api/auth/kakao/callback
# 운영: https://saju-tarot-production.up.railway.app/api/auth/kakao/callback
KAKAO_REDIRECT_URI=http://localhost:3001/api/auth/kakao/callback
# 로그인 뒤 돌아갈 화면 주소(쉼표로 구분). 비우면 운영은 saju-tarot.vercel.app, 로컬은 localhost:5173·3001
# 콜백 주소의 서버(화면도 내려줌)는 항상 허용
SOCIAL_LOGIN_RETURN_ORIGINS=

# 리딩을 상담사 목소리로 듣기 (Fish Audio). 비워 두면 듣기 버튼이 보이지 않음
FISH_API_KEY=
# 목소리 바꾸기(선택). 기본: 차분하고 따뜻한 여성 목소리
FISH_VOICE_ID=
# 서버 전체에서 하루에 새로 만드는 음성 수 상한(선택, 기본 300)
VOICE_DAILY_LIMIT=
